# ============================================================
# Environment variables — copy this file to .env and fill in.
# NEVER commit the real .env file (it is gitignored).
# ============================================================

# ---- Frontend (Vite exposes any VITE_* var to the browser) ----
# Paystack PUBLIC key. Safe to ship to the browser.
# Optional with the redirect checkout, but set it so the UI can show a
# clear "payments not configured" message during development.
# Test keys start with pk_test_, live keys with pk_live_.
VITE_PAYSTACK_PUBLIC_KEY=

# ---- Server (Express) ----
# Port for the server (default 8787).
PORT=8787

# Paystack SECRET key. SERVER ONLY. Never prefix with VITE_,
# never put it in frontend files, never commit it.
# Test keys start with sk_test_, live with sk_live_.
# Get both keys at dashboard.paystack.com > Settings > API Keys & Webhooks.
PAYSTACK_SECRET_KEY=

# Signing key for temporary download tokens.
# Optional — defaults to PAYSTACK_SECRET_KEY when unset.
DOWNLOAD_SECRET=

# Download token lifetime in seconds (default 3600 = 1 hour).
DOWNLOAD_TOKEN_TTL=3600

# ---- Order store (optional — recommended in production) ----
# No database by default. Local dev persists orders to ./data/orders.json.
# On Vercel, orders are in-memory per instance unless you enable Upstash
# Redis (vercel.com > Storage > Create > Upstash). Set BOTH vars to use it.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Private storage ----
# PRODUCTION (Vercel): create a Blob store (vercel.com > project >
# Storage) and set BLOB_READ_WRITE_TOKEN. Upload PDFs with:
#   npm run books:upload
# DEV: leave BLOB_READ_WRITE_TOKEN empty and it reads server/private/books/.
BLOB_READ_WRITE_TOKEN=

# Alternative: stream from private remote storage (S3-compatible).
# PRIVATE_STORAGE_URL=https://your-private-bucket.example.com/books
# PRIVATE_STORAGE_KEY=your-bucket-access-key

# -------- CORS ---------
# Extra allowed browser origins (comma separated) if the frontend
# and server are hosted separately in production.
# ALLOWED_ORIGINS=https://priscilla.example.com

# -------- Webhooks --------
# Point Paystack at <your-domain>/api/paystack/webhook
# (dashboard.paystack.com > Settings > API Keys & Webhooks > Webhook URL).
# Signatures are verified with PAYSTACK_SECRET_KEY — nothing extra to set.