# ============================================================
# Environment variables — copy this file to .env and fill in.
# NEVER commit the real .env file (it is gitignored).
# ============================================================

# ---- Frontend (Vite exposes any VITE_* var to the browser) ----
# Paystack PUBLIC key. Safe to ship to the browser.
# Test keys start with pk_test_, live keys with pk_live_.
VITE_PAYSTACK_PUBLIC_KEY=

# ---- Server (Express) ----
# Port for the server (default 8787).
PORT=8787

# Paystack SECRET key. SERVER ONLY. Never prefix with VITE_,
# never put it in frontend files, never commit it.
# Test keys start with sk_test_, live with sk_live_.
PAYSTACK_SECRET_KEY=

# Signing key for temporary download tokens.
# Optional — defaults to PAYSTACK_SECRET_KEY when unset.
DOWNLOAD_SECRET=

# Download token lifetime in seconds (default 3600 = 1 hour).
DOWNLOAD_TOKEN_TTL=3600

# ---- Private storage (optional) ----
# Leave empty to serve downloads from server/private/books/.
# Set these to stream from private remote storage (the real PDFs
# must never live in public/).
# PRIVATE_STORAGE_URL=https://your-private-bucket.example.com/books
# PRIVATE_STORAGE_KEY=your-bucket-access-key

# -------- CORS ---------
# Extra allowed browser origins (comma separated) if the frontend
# and server are hosted separately in production.
# ALLOWED_ORIGINS=https://priscilla.example.com