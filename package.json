{
  "name": "priscilla-adubia-asamoah-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio and digital shop for Priscilla Adubia Asamoah — Pastry Chef, Cake Artist & Dessert Specialist",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "nodemon --watch server --watch .env server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "server": "node server/index.mjs",
    "books:upload": "node scripts/upload-books-to-blob.mjs"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.8.0",
    "@vercel/blob": "^0.27.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
